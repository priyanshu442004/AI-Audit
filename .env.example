# PostgreSQL and S3 settings already used by the existing application.
DATABASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
ANTHROPIC_API_KEY=
BACKEND_URL=http://localhost:8000

# SMTP delivery. Use an app-specific credential where your mail provider supports it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
KPI_EMAIL_RECIPIENTS=anoop@analytx4t.com,amit@analytx4t.com

# The report does not call an external AI service; these are reserved and unused.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=

# Daily schedule. The server must be running at the scheduled time.
KPI_SCHEDULER_ENABLED=true
KPI_SCHEDULE_CRON=0 9 * * *
KPI_SCHEDULE_TIMEZONE=Asia/Kolkata

# Source entity for the daily dashboard-aligned report.
KPI_REPORT_ENTITY=ITL

# Required to enable administrator endpoints. Set a high-entropy secret.
KPI_ADMIN_TOKEN=

# Defaults: backend/generated_reports and the system temporary directory.
KPI_PDF_OUTPUT_DIR=
KPI_PDF_TEMP_DIR=
